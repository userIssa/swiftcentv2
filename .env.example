# MongoDB Connection String (use MongoDB Atlas or hosted MongoDB in production)
MONGODB_URI=mongodb://127.0.0.1:27017/swiftcent

# Session Signing Secret (generate a strong random secret in production, e.g. openssl rand -hex 32)
AUTH_SECRET=replace_with_a_64_char_random_secret

# Gemini Live API Key (required for Voice-to-Quote & Voice-to-Invoice Copilot)
# Get a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Comma-separated dev/presenter emails allowed to see "Load Sample Data"
# Leave blank in production if no sample data button should ever appear
# DEV_SAMPLE_ACCOUNT_EMAILS=founder@yourcompany.com

# Optional: Stripe Payment Gateway Keys
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

